# ---------------------------------------------------------------------------
# Orbital Rendezvous Simulator - pilot platform configuration
# ---------------------------------------------------------------------------
# Copy to .env and fill in. PLACEHOLDERS ONLY IN THIS FILE -- never commit real
# secrets. .env is git-ignored.
#
# On Streamlit Community Cloud, put these in the app's Secrets panel instead of
# a .env file. Nothing here is read from disk at runtime unless you load it
# yourself (for example with `python -m dotenv run -- streamlit run pilot_app.py`).
#
# Every value has a working default, so an empty environment runs locally.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# development | demo | test | production
# ANY value other than "production" marks every record written as demo data,
# which the administrator dashboard excludes from reports by default. That is
# what keeps your own testing out of the real pilot figures. Set this to
# production ONLY on the instance participants actually use.
PILOT_ENV=development

# Shown in the footer and stored with every event, so you can tell which build
# produced a given record.
PILOT_APP_VERSION=1.0.0


# --- Database --------------------------------------------------------------
# Leave unset for local development: a SQLite file is created at
# ./pilot_data/pilot.db and nothing else is needed.
#
# REQUIRED for a hosted pilot. Most hosts (Streamlit Community Cloud included)
# give the app an ephemeral filesystem that is wiped on every restart and
# redeploy, so SQLite there means silently losing all pilot data. Point this at
# a managed Postgres instance (Neon, Supabase, Railway, RDS...).
#
# DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require


# --- Anonymous participant identity ----------------------------------------
# Secret key used to hash participant codes. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# REQUIRED in production. If unset, a random salt is generated per process,
# which means returning participants are NOT recognised after a restart and
# your return-rate figures will be wrong.
#
# Changing this later makes every existing participant look new. Set it once,
# before the pilot starts, and keep it.
# PILOT_PARTICIPANT_SALT=CHANGE_ME_64_HEX_CHARACTERS


# --- Administrator credentials ---------------------------------------------
# The dashboard is at /?view=admin. With nothing configured it refuses to
# unlock at all -- there is no default password.
PILOT_ADMIN_USERNAME=CHANGE_ME

# Preferred: a PBKDF2 hash, so the plaintext never exists in the deployment
# environment. Generate with:
#     python scripts/hash_password.py
# PILOT_ADMIN_PASSWORD_HASH=pbkdf2_sha256$240000$SALT_HEX$HASH_HEX

# Simpler alternative, acceptable for a small pilot but weaker: plain text.
# Set only ONE of these two. If both are set, the hash wins.
# PILOT_ADMIN_PASSWORD=CHANGE_ME

# Failed sign-in attempts before the form locks for five minutes.
PILOT_ADMIN_MAX_ATTEMPTS=5


# --- Privacy ---------------------------------------------------------------
# When false (the default), the orbital parameters participants type are NOT
# stored -- only coarse bands such as "separation 100 m to 1 km".
#
# Turning this on records the raw values. Only do so with participants'
# informed consent; the consent page changes its wording to say so, and the
# administrator dashboard shows a standing warning.
PILOT_LOG_RAW_PARAMETERS=false

# How long pilot data is kept, in days. Stated on the consent page.
# Deletion is NOT automatic -- run scripts/purge_expired.py on a schedule.
PILOT_RETENTION_DAYS=730


# --- Resource safeguards ---------------------------------------------------
# Guards against accidental exhaustion of a shared server, not against attack.
# The engine itself has no such limits when run locally.
PILOT_MAX_RUNS_PER_SESSION=300
PILOT_MAX_RUNS_PER_MINUTE=20

# Largest simulation a single request may ask for. The high-fidelity comparison
# path costs about 0.4 ms per step, so 40 000 steps is roughly 17 seconds.
PILOT_MAX_SIMULATION_STEPS=40000
PILOT_MAX_ESTIMATED_SECONDS=20


# --- Pilot access control --------------------------------------------------
# When true, only pilot codes registered with scripts/seed_pilot_codes.py are
# accepted. When false (the default), any code is accepted and unregistered
# ones are grouped under an "Unregistered pilot code" organisation.
PILOT_REQUIRE_KNOWN_CODE=false


# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Logs never contain participant codes,
# free-text feedback, orbital parameters or database passwords.
PILOT_LOG_LEVEL=INFO
