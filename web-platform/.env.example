# ---------------------------------------------------------------------------
# Orbital Rendezvous Simulator - web platform configuration
# ---------------------------------------------------------------------------
# Copy to .env and fill in. PLACEHOLDERS ONLY IN THIS FILE - never commit real
# secrets. .env is git-ignored and excluded from the Docker image.
#
# Every value has a working default, so an empty environment runs locally.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# development | demo | test | production
#
# ANY value other than "production" marks every record written as demo data,
# which the administrator report excludes by default. That is what keeps your
# own testing out of the real pilot figures. Set this to production ONLY on the
# instance participants actually use.
PILOT_ENV=development

# Recorded with every event, so a record can be traced to the build that made it.
PILOT_APP_VERSION=1.0.0

# DEBUG | INFO | WARNING | ERROR. Logs never contain participant codes,
# orbital parameters, feedback text or database passwords.
PILOT_LOG_LEVEL=INFO


# --- Database --------------------------------------------------------------
# Unset for local development: a SQLite file is created at ./pilot_data/pilot.db
# and nothing else is needed.
#
# REQUIRED for a hosted deployment. Render, Railway, Fly.io and Streamlit Cloud
# all give the app an ephemeral filesystem that is wiped on restart and
# redeploy, so SQLite there means silently losing every pilot record. Point this
# at managed Postgres (Neon, Supabase, Railway, RDS).
#
# Note the +psycopg driver prefix. If your provider gives you a plain
# postgres:// URL, rewrite the scheme.
#
# DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require


# --- Anonymous participant identity ----------------------------------------
# Secret key used to hash participant codes. Generate with:
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# REQUIRED in production. If unset, a random salt is generated per process,
# which means returning participants are NOT recognised after a restart and the
# return-rate figures are wrong.
#
# Set it once, before the pilot starts, and never change it: changing it makes
# every existing participant look new.
# PILOT_PARTICIPANT_SALT=CHANGE_ME_64_HEX_CHARACTERS


# --- Administrator credentials ---------------------------------------------
# The administrator API requires HTTP Basic credentials on every request. With
# nothing configured it refuses everything - there is no default password, and
# the route is genuinely protected rather than merely unadvertised.
PILOT_ADMIN_USERNAME=CHANGE_ME

# Preferred: a PBKDF2 hash, so the plaintext never exists in the deployment
# environment. Generate with:
#     python scripts/hash_password.py
# The value contains $ characters - quote it in shells and secret managers.
# PILOT_ADMIN_PASSWORD_HASH=pbkdf2_sha256$240000$SALT_HEX$HASH_HEX

# Simpler alternative, weaker: plain text. Set only ONE of these two; if both
# are set, the hash wins.
# PILOT_ADMIN_PASSWORD=CHANGE_ME

# Failed sign-in attempts before the check locks for five minutes.
PILOT_ADMIN_MAX_ATTEMPTS=5


# --- Privacy ---------------------------------------------------------------
# When false (the default), the orbital parameters participants type are NOT
# stored - only coarse bands such as "separation 100 m to 1 km".
#
# Turning this on records the exact values. Only do so with participants'
# informed consent; the consent page changes its wording to say so, and the
# administrator view shows a standing warning.
PILOT_LOG_RAW_PARAMETERS=false

# How long pilot data is kept, in days. Stated on the consent page.
# Deletion is NOT automatic - schedule scripts/purge_expired.py.
PILOT_RETENTION_DAYS=730


# --- Resource safeguards ---------------------------------------------------
# Guards against accidental exhaustion of a shared server, not against attack.
# The engine has no such limits when run locally.
#
# The rate limiter is in-process: with N workers the effective limit is N times
# the configured value.
PILOT_MAX_RUNS_PER_SESSION=300
PILOT_MAX_RUNS_PER_MINUTE=20

# Largest simulation a single request may ask for. The high-fidelity comparison
# path costs about 0.4 ms per step, so 40 000 steps is roughly 17 seconds.
PILOT_MAX_SIMULATION_STEPS=40000
PILOT_MAX_ESTIMATED_SECONDS=20


# --- Pilot access control --------------------------------------------------
# When true, only pilot codes registered with scripts/seed_pilot_codes.py are
# accepted. When false, any code works and unregistered ones are grouped under
# an "Unregistered pilot code" organisation while remaining distinguishable as
# separate cohorts.
PILOT_REQUIRE_KNOWN_CODE=false


# --- Serving ---------------------------------------------------------------
# Port the API listens on. Most hosts inject this themselves.
PORT=8000

# Uvicorn workers. One by default: the engine is CPU-bound pure Python, so
# extra workers multiply memory without improving throughput on a small host.
WEB_CONCURRENCY=1

# CORS is only needed when the frontend is served from a DIFFERENT origin than
# the API. In the standard deployment they share an origin, so leave this empty.
# Comma-separated, no trailing slash.
# CORS_ALLOW_ORIGINS=https://simulator.example.org

# Where the built frontend lives inside the image. The Dockerfile places it at
# app/static; override only for an unusual layout.
# FRONTEND_DIST=/app/app/static

# Repository root, if orbital_core/ and pilot/ are not two levels above the
# backend package. The Dockerfile layout does not need this.
# ORBITAL_REPO_ROOT=/app
